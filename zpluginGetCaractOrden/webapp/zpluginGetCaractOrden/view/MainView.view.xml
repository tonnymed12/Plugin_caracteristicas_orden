<mvc:View   xmlns:mvc="sap.ui.core.mvc" 
            xmlns="sap.m" 
            xmlns:ndc="sap.ndc"
            xmlns:l="sap.ui.layout" 
            xmlns:f="sap.ui.layout.form" 
            xmlns:core="sap.ui.core" 
            xmlns:html="http://www.w3.org/1999/xhtml" 
            controllerName="serviacero.custom.plugins.zpluginGetCaractOrden.zpluginGetCaractOrden.controller.MainView" 
            width="100%" 
            height="100%">
		
        <Panel 
                id="panelPlugin"  
                width="100%"
                height="100%"
                expandable="false"
                expanded="false"
                accessibleRole="Region"
                backgroundDesign="Transparent"
                class="sapUiNoContentPadding">  
            <headerToolbar>
                <OverflowToolbar>
                    <Title
                        text="{i18n>customTitle.title}"
                        level="H2"
                    />
                    <ToolbarSpacer />
                </OverflowToolbar>
            </headerToolbar>
        <content> 
           <Table busyIndicatorDelay="10" id="CUSTOM_PLUGIN_ORDER_TABLE" mode="None"
            alternateRowColors="true"
            items="{
            path: '/ITEMS',
            sorter: { path: 'attribute' }
            }"
            growing="true" growingThreshold="500">

                <columns>
                    <Column hAlign="Begin" vAlign="Middle" width="50%">
                        <Label text="{i18n>customDataTable.columnAttribute}" />
                    </Column>
                    <Column hAlign="Begin" vAlign="Middle" width="50%">
                        <Label text="{i18n>customDataTable.description}" />
                    </Column>
                    <Column hAlign="Begin" vAlign="Middle" width="50%">
                        <Label text="{i18n>customDataTable.columnValue}" />
                    </Column>
                </columns>

                <items>
                    <ColumnListItem>
                        <Text text="{attribute}" />
                        <Text text="{description}" />
                        <Text text="{value}" />
                    </ColumnListItem>
                </items>

            </Table>
        </content>
	    </Panel>		
        
  
</mvc:View>