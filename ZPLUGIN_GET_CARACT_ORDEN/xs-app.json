{
  "welcomeFile": "/ZPLUGIN_GET_CARACT_ORDEN/index.html",
  "authenticationMethod": "none",
  "logout": {
    "logoutEndpoint": "/do/logout"
  },
  "routes": [
    {
      "source": "^/ZPLUGIN_GET_CARACT_ORDEN/(.*)$",
      "target": "$1",
      "localDir": "webapp"
    },
    {
      "source": "^/sapApi/(.*)$",
      "target": "$1",
      "destination": "SAP_API_TST",
      "authenticationType": "xsuaa"      
    }
  ]
}